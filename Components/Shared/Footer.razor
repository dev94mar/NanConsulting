<footer class="app-footer @CssClass">
    <div class="footer-section footer-logos">
        @if (LogosContent is not null)
        {
            @LogosContent
        }
        else
        {
            @foreach (var logo in Logos)
            {
                <a class="footer-logo" href="@logo.Href" target="_blank" rel="noopener noreferrer" title="@logo.Name">
                    <img src="@logo.ImageUrl" alt="@logo.Name" />
                </a>
            }
        }
    </div>

    <div class="footer-section footer-copyright">
        <span>&copy; @DateTime.Now.Year @SiteName. Todos los derechos reservados.</span>
    </div>

    <div class="footer-section footer-social">
        @if (SocialContent is not null)
        {
            @SocialContent
        }
        else
        {
            @foreach (var link in SocialLinks)
            {
                <a class="footer-social-link" href="@link.Href" target="_blank" rel="noopener noreferrer" aria-label="@link.Name">
                    @((MarkupString)link.IconSvg)
                </a>
            }
        }
    </div>
</footer>

@code {
    [Parameter]
    public string SiteName { get; set; } = "NanConsulting";

    [Parameter]
    public string? CssClass { get; set; }

    [Parameter]
    public RenderFragment? LogosContent { get; set; }

    [Parameter]
    public RenderFragment? SocialContent { get; set; }

    [Parameter]
    public List<FooterLogo> Logos { get; set; } = [];

    [Parameter]
    public List<FooterSocialLink> SocialLinks { get; set; } = FooterSocialLink.Defaults();

    public sealed record FooterLogo(string Name, string ImageUrl, string Href = "#");

    public sealed record FooterSocialLink(string Name, string IconSvg, string Href)
    {
        public static List<FooterSocialLink> Defaults() =>
