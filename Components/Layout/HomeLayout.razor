@inherits LayoutComponentBase

<div class="home-page">
    <header class="home-header">
        <div class="home-header-inner">
            <a class="home-brand" href="">LawyerConsulting</a>
            <nav class="home-nav">
                <NavLink class="home-nav-link" href="" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink class="home-nav-link" href="services">Services</NavLink>
                <NavLink class="home-nav-link" href="about">About</NavLink>
                <NavLink class="home-nav-link" href="contact">Contact</NavLink>
            </nav>
        </div>
    </header>

    <main class="home-content">
        @Body
    </main>

    <footer class="home-footer">
        <span>&copy; @DateTime.Now.Year LawyerConsulting. All rights reserved.</span>
    </footer>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
